{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pouch.local/schemas/architecture-1.0.json",
  "title": "Architecture design source 1.0",
  "description": "Authoritative machine-readable architecture source. Semantic reference, scoped-view and evidence validation is also performed by render_architecture.py. HTML is only a derived read-only snapshot.",
