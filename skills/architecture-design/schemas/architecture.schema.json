  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}(?![\\s\\S])"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "status": {
      "enum": [
        "current",
        "planned",
        "proposed",
        "unknown"
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/text"
        },
        "lines": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(?:-[1-9][0-9]*)?(?![\\s\\S])",
          "maxLength": 21
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "architecture": {
