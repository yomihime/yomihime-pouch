  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "revision": {
      "$ref": "#/$defs/text"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "summary": {
      "$ref": "#/$defs/text"
    },
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      },
      "minItems": 1,
      "maxItems": 2000
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      },
      "minItems": 0,
      "maxItems": 2000
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      },
      "minItems": 0,
      "maxItems": 2000
