  "contracts": [
    {
      "id": "create-order",
      "name": "提交订单",
      "status": "planned",
      "description": "在一次事务中完成订单、库存预留与事件记录；幂等键确保重试不创建重复订单。",
      "inputs": [
        {
          "name": "idempotencyKey",
          "type": "string",
          "required": true,
          "description": "同一提交保持不变。",
          "constraints": [
            "长度 1–128",
            "按调用者身份隔离"
          ]
        },
        {
          "name": "items",
          "type": "array<{sku:string,quantity:integer}>",
          "required": true,
          "constraints": [
            "至少一项",
            "quantity 为正整数",
            "重复 SKU 在业务层合并后校验"
          ]
        }
      ],
      "outputs": [
        {
          "name": "orderId",
          "type": "string",
          "required": true
        },
        {
          "name": "status",
          "type": "confirmed",
          "required": true
        }
      ],
      "errors": [
        {
          "code": "INVALID_INPUT",
          "description": "请求缺字段或数量非法",
          "recovery": "返回字段级错误，不进入业务事务。"
        },
        {
          "code": "OUT_OF_STOCK",
          "description": "至少一个 SKU 库存不足",
          "recovery": "回滚整个事务，返回不足项；用户修改后重新提交。"
        },
        {
          "code": "IDEMPOTENCY_CONFLICT",
          "description": "同一幂等键对应不同请求",
          "recovery": "拒绝覆盖旧订单，提示新建提交。"
        }
      ],
      "rules": [
        "访问接口负责格式校验，订单模块负责业务校验",
        "事务提交之前不调用外部通知",
        "幂等键命中且请求相同则返回既有结果"
      ],
      "stateTransitions": [
        {
          "from": "draft",
          "to": "confirmed",
          "trigger": "库存预留与订单事务提交成功"
        },
        {
          "from": "draft",
          "to": "rejected",
          "trigger": "输入校验失败或库存不足"
        }
      ],
      "examples": [
        {
          "name": "正常提交",
          "input": {
            "idempotencyKey": "demo-01",
            "items": [
              {
                "sku": "DEMO-BOOK",
                "quantity": 1
              }
            ]
          },
          "output": {
            "orderId": "order-demo-01",
            "status": "confirmed"
          }
        },
        {
          "name": "库存不足",
          "input": {
            "idempotencyKey": "demo-02",
            "items": [
              {
                "sku": "DEMO-BOOK",
                "quantity": 999999
              }
            ]
          },
          "output": {
            "error": "OUT_OF_STOCK",
            "retryable": false
          }
        }
      ],
      "progress": "in_progress",
      "progressEvidence": [
